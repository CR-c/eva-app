{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["es2018", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "removeComments": false,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "strict": true,
    "sourceMap": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "typeRoots": [
      "node_modules/@types",
      "node_modules/@nutui/nutui-react-taro/dist/types"
    ],
    "types": [
      "@tarojs/taro",
      "node"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@nutui/nutui-react-taro": ["node_modules/@nutui/nutui-react-taro"],
      "@nutui/nutui-react-taro/*": ["node_modules/@nutui/nutui-react-taro/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "./src/**/*",
    "./types/**/*",
    "./config/**/*",
    "./global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "compileOnSave": false,
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
